    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import numpy as np\n",
        "\n",
        "# Estilo ggplot\n",
        "plt.style.use('ggplot')\n",
        "\n",
        "# Dados fornecidos\n",
        "dados = {\n",
        "    \"Índice\": list(range(1, 18)),\n",
        "    \"Altura (cm)\": [192, 175, 180, 180, 193, 183, 167, 164, 178, 169, 169, 180, 181, 172, 160, 171, 181],\n",
        "    \"Calçado\":    [43, 40, 43, 43, 45, 43, 37, 36, 39, 37, 39, 41, 42, 38, 36, 41, 42]\n",
        "}\n",
        "\n",
        "# Criando o DataFrame\n",
        "df = pd.DataFrame(dados)\n",
        "\n",
        "# Cálculos estatísticos\n",
        "media_altura = df[\"Altura (cm)\"].mean()\n",
        "media_calcado = df[\"Calçado\"].mean()\n",
        "correlacao = df[\"Altura (cm)\"].corr(df[\"Calçado\"])\n",
        "\n",
        "print(f\"Média de altura: {media_altura:.4f} cm\")\n",
        "print(f\"Média do calçado: {media_calcado:.4f}\")\n",
        "print(f\"Correlação de Pearson: r = {correlacao:.4f}\")\n",
        "\n",
        "# Gráfico de dispersão\n",
        "plt.figure(figsize=(8, 6))\n",
        "sns.scatterplot(x=\"Altura (cm)\", y=\"Calçado\", data=df, s=80, edgecolor='black')\n",
        "plt.title(\"Altura x Tamanho do Calçado (Engenharia Civil - 4º período)\", fontsize=14)\n",
        "plt.xlabel(\"Altura (cm)\")\n",
        "plt.ylabel(\"Tamanho do Calçado\")\n",
        "plt.grid(True)\n",
        "plt.show()"
