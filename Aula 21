      "source": [
        "import numpy as np\n",
        "import statsmodels.api as sm\n",
        "from sklearn.metrics import mean_absolute_error\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
        "\n",
        "# Dados\n",
        "altura = np.array([160, 165, 170, 175, 178, 180, 185, 190, 193])\n",
        "tamanho_calcado = np.array([36, 37, 39, 40, 41, 42, 43, 44, 45])"
      ],
      "metadata": {
        "id": "s2DN5Sd6KtJs"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# === Modelo COM intercepto ===\n",
        "X_com_intercepto = sm.add_constant(altura)  # adiciona coluna de 1s\n",
        "modelo_com_intercepto = sm.OLS(tamanho_calcado, X_com_intercepto).fit()\n",
        "y_pred_com_intercepto = modelo_com_intercepto.predict(X_com_intercepto)\n",
        "\n",
        "# Cálculo das métricas de erro\n",
        "mae_com_intercepto = mean_absolute_error(tamanho_calcado, y_pred_com_intercepto)\n",
        "mse_com_intercepto = mean_squared_error(tamanho_calcado, y_pred_com_intercepto)\n",
        "rmse_com_intercepto = np.sqrt(mse_com_intercepto)"
      ],
      "metadata": {
        "id": "REHg6cfiWMFi"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# === Modelo SEM intercepto ===\n",
        "X_sem_intercepto = altura.reshape(-1, 1)  # sem constante\n",
        "modelo_sem_intercepto = sm.OLS(tamanho_calcado, X_sem_intercepto).fit()\n",
        "y_pred_sem_intercepto = modelo_sem_intercepto.predict(X_sem_intercepto)\n",
        "\n",
        "# Cálculo das métricas de erro\n",
        "mae_sem_intercepto = mean_absolute_error(tamanho_calcado, y_pred_sem_intercepto)\n",
        "mse_sem_intercepto = mean_squared_error(tamanho_calcado, y_pred_sem_intercepto)\n",
        "rmse_sem_intercepto = np.sqrt(mse_sem_intercepto)"
