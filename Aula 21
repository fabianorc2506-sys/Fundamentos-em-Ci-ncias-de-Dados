        "***Exemplos de Interpretação de r (coeficiente de correlação de Pearson)***"
      ],
      "metadata": {
        "id": "M1c5GLnj-vTi"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# Aplicando o estilo ggplot\n",
        "plt.style.use('ggplot')\n",
        "\n",
        "# Valores desejados de correlação\n",
        "r_values = [-1, -0.75, -0.5, -0.25, 0, 0.25, 0.5, 0.75, 1]\n",
        "\n",
        "# Configura a figura 3x3\n",
        "fig, axes = plt.subplots(3, 3, figsize=(12, 12))\n",
        "fig.suptitle(\"Diagramas de Dispersão para Diferentes Valores de Correlação\", fontsize=16)\n",
        "\n",
        "# Semente para reprodutibilidade\n",
        "np.random.seed(42)\n",
        "\n",
        "# Loop para criar os gráficos\n",
        "for ax, r in zip(axes.flatten(), r_values):\n",
        "    x = np.random.normal(0, 1, 100)\n",
        "    e = np.random.normal(0, 1, 100)\n",
        "    y = r * x + np.sqrt(1 - r**2) * e  # Geração com correlação aproximada\n",
        "\n",
        "    ax.scatter(x, y, alpha=0.8, edgecolor='k')\n",
        "    ax.set_title(f\"$r = {r}$\", fontsize=12)\n",
        "    ax.set_xticks([])\n",
        "    ax.set_yticks([])\n",
        "    ax.set_xlim(-4, 4)\n",
        "    ax.set_ylim(-4, 4)\n",
        "\n",
        "plt.tight_layout(rect=[0, 0, 1, 0.95])\n",
        "plt.show()"
      ],
