        "# Importar bibliotecas\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.linear_model import LinearRegression\n",
        "\n",
        "# Dados fictícios\n",
        "area_m2 = np.array([50, 60, 80, 100, 120, 150, 180]).reshape(-1, 1)\n",
        "preco_mil_reais = np.array([150, 180, 240, 300, 360, 450, 540])\n",
        "\n",
        "# Criar e treinar o modelo\n",
        "modelo = LinearRegression()\n",
        "modelo.fit(area_m2, preco_mil_reais)\n",
        "\n",
        "# Previsão para 90 m²\n",
        "area_nova = np.array([[90]])\n",
        "previsao = modelo.predict(area_nova)\n",
        "\n",
        "# Exibir resultados\n",
        "print(f'Coeficiente angular (β₁):          {modelo.coef_[0]:.2f} mil R$ por m²')\n",
        "print(f'Intercepto (β₀):                   {modelo.intercept_:.2f} mil R$')\n",
        "print(f'Preço previsto para 90 m²:        R$ {previsao[0]:.2f} mil')\n",
        "\n",
        "# Gráfico\n",
        "plt.figure(figsize=(9, 6))\n",
        "plt.scatter(area_m2, preco_mil_reais,\n",
        "            color='blue', s=80, alpha=0.8, label='Dados observados')\n",
        "plt.plot(area_m2, modelo.predict(area_m2),\n",
        "         color='red', linewidth=2.5, label='Reta de regressão')\n",
        "plt.scatter(area_nova, previsao,\n",
        "            color='green', s=120, marker='*', edgecolor='black',\n",
        "            label=f'Previsão 90 m² → R$ {previsao[0]:.0f} mil')\n",
        "\n",
        "plt.xlabel('Área construída (m²)', fontsize=12)\n",
        "plt.ylabel('Preço (mil reais)', fontsize=12)\n",
        "plt.title('Regressão Linear Simples: Preço vs Área', fontsize=14)\n",
        "plt.legend(loc='upper left', fontsize=10)\n",
        "plt.grid(True, linestyle='--', alpha=0.7)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
