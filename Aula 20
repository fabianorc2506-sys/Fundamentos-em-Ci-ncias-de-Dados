        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import pandas as pd\n",
        "\n",
        "# Exemplo de dados fictícios\n",
        "data = {\n",
        "    'Área (m²)': [50, 60, 70, 80, 90, 100, 110, 120],\n",
        "    'Preço (mil R$)': [200, 240, 280, 300, 330, 370, 390, 420]\n",
        "}\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Estilo e paleta\n",
        "sns.set(style=\"whitegrid\")\n",
        "\n",
        "# Gráfico de regressão\n",
        "plt.figure(figsize=(8, 5))\n",
        "sns.regplot(x='Área (m²)', y='Preço (mil R$)', data=df, color='green', marker='o', ci=None)\n",
        "\n",
        "plt.title('Relação entre Área da Casa e Preço', fontsize=14)\n",
        "plt.xlabel('Área (m²)', fontsize=12)\n",
        "plt.ylabel('Preço (mil R$)', fontsize=12)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"grafico_regressao.png\", dpi=300)  # Salva a imagem\n",
        "plt.show()\n"
      ]
